# Copyright (c) 2026 Alesson Queiroz and the Caecilia contributors.
#
# Checks chosen for what this project actually is: real-time audio DSP with a
# hard no-allocation contract on the render path, plus a hand-written lock-free
# handoff between the audio thread and the UI. The bugs that matter here are
# silent ones -- a narrowing conversion in a coefficient, an off-by-one in a ring
# index, a member left uninitialised -- so the emphasis is bugprone-*, the
# core-guidelines subset that covers initialisation and casts, and performance.
#
# Deliberately NOT enabled:
#   readability-identifier-naming  -- .clang-format and review cover style, and a
#                                     naming check on a JUCE-adjacent codebase is
#                                     nothing but noise.
#   modernize-use-trailing-return  -- a house style question, not a defect.
#   fuchsia-*, llvmlibc-*, altera-* -- not our platform.

Checks: >
  bugprone-*,
  cert-*,
  concurrency-*,
  cppcoreguidelines-init-variables,
  cppcoreguidelines-narrowing-conversions,
  cppcoreguidelines-prefer-member-initializer,
  cppcoreguidelines-pro-type-cstyle-cast,
  cppcoreguidelines-pro-type-member-init,
  cppcoreguidelines-pro-type-static-cast-downcast,
  cppcoreguidelines-slicing,
  cppcoreguidelines-virtual-class-destructor,
  misc-*,
  modernize-*,
  performance-*,
  portability-*,
  readability-braces-around-statements,
  readability-const-return-type,
  readability-inconsistent-declaration-parameter-name,
  readability-misleading-indentation,
  readability-redundant-*,
  readability-simplify-boolean-expr,
  -bugprone-easily-swappable-parameters,
  -misc-include-cleaner,
  -misc-non-private-member-variables-in-classes,
  -modernize-use-trailing-return-type,
  -readability-braces-around-statements

WarningsAsErrors: >
  bugprone-use-after-move,
  bugprone-dangling-handle,
  bugprone-infinite-loop,
  bugprone-integer-division,
  bugprone-sizeof-expression,
  bugprone-string-constructor,
  bugprone-suspicious-memset-usage,
  bugprone-undefined-memory-manipulation,
  bugprone-unhandled-self-assignment,
  cert-flp30-c,
  concurrency-mt-unsafe,
  cppcoreguidelines-pro-type-member-init,
  cppcoreguidelines-virtual-class-destructor

# Only our own sources; JUCE and Catch2 are not ours to lint.
HeaderFilterRegex: 'src/caecilia/.*\.h$'

CheckOptions:
  - key:   readability-identifier-length.MinimumVariableNameLength
    value: '1'
  - key:   performance-unnecessary-value-param.AllowedTypes
    value: 'PipeId;StopId;RankId;DivisionId;WindchestId;Footage;VoiceHandle'
  - key:   cppcoreguidelines-narrowing-conversions.WarnOnIntegerNarrowingConversion
    value: 'true'
  - key:   misc-const-correctness.AnalyzeValues
    value: 'false'
